<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="#000000">
    <ListView android:id="@+id/channelList"
        android:layout_width="320dp" android:layout_height="match_parent"
        android:background="#202020" android:choiceMode="singleChoice"
        android:listSelector="#3367D6" android:divider="#333333" android:dividerHeight="1dp"/>
    <FrameLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1">
        <androidx.media3.ui.PlayerView android:id="@+id/player"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:resize_mode="fit"/>
        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000" android:textColor="#FFFFFF"
            android:textSize="18sp" android:padding="12dp"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
